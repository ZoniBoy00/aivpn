[Unit]
Description=AiVPN Proton WireGuard relay (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aivpn
ExecStartPre=-/usr/bin/docker rm -f aivpn-%i
ExecStart=/usr/bin/docker run --name aivpn-%i --cap-drop=ALL --cap-add=NET_ADMIN --security-opt=no-new-privileges:true --device=/dev/net/tun:/dev/net/tun --tmpfs /run:rw,noexec,nosuid,size=16m --tmpfs /tmp:rw,noexec,nosuid,size=32m --tmpfs /var/log/aivpn:rw,noexec,nosuid,size=16m --memory=256m --pids-limit=128 --log-opt max-size=10m --log-opt max-file=3 -v /opt/aivpn/config/%i.conf:/etc/wireguard/wg0.conf:ro -p 127.0.0.1:1080:1080 -e WG_CONF=/etc/wireguard/wg0.conf -e HEALTH_INTERVAL=60 -e SOCKS_PORT=1080 aivpn:latest daemon
ExecStop=/usr/bin/docker stop -t 15 aivpn-%i
ExecStopPost=-/usr/bin/docker rm -f aivpn-%i
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
