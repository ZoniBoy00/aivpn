# AiVPN — systemd template unit
#
# One instance = one location (config/<location>.conf), e.g. aivpn@fi.service.
# Only ONE instance can be active at a time: they share localhost:1080 and the
# wrapper replaces any running AiVPN container on start. To switch location:
#   systemctl disable --now aivpn@fi && systemctl enable --now aivpn@us
#
# Optional overrides (AIVPN_HOST_PORT, SOCKS_ALLOW_FROM, SOCKS_USER, SOCKS_PASS,
# HEALTHCHECK_URL, TUNNEL_DNS) go in /opt/aivpn/aivpn.env.

[Unit]
Description=AiVPN Proton WireGuard relay (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aivpn
EnvironmentFile=-/opt/aivpn/aivpn.env
ExecStart=/opt/aivpn/scripts/aivpn foreground %i
ExecStop=/usr/bin/docker stop -t 15 aivpn-%i
ExecStopPost=-/usr/bin/docker rm -f aivpn-%i
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
